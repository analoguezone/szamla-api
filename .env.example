# =================================
# Server Configuration
# =================================
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# =================================
# Database
# =================================
DATABASE_URL=postgresql://szamla:dev_password@localhost:5432/szamla_api

# =================================
# Redis
# =================================
REDIS_URL=redis://localhost:6379

# =================================
# Security (CHANGE IN PRODUCTION!)
# =================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_SECRET=your-super-secret-key-change-in-production-min-32-chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# =================================
# NAV API
# =================================
NAV_BASE_URL=https://api-test.onlineszamla.nav.gov.hu/invoiceService/v3
NAV_TIMEOUT_MS=70000
NAV_API_VERSION=v3

# =================================
# Stripe
# =================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# =================================
# Storage
# =================================
STORAGE_TYPE=local
STORAGE_PATH=./storage

# =================================
# Logging
# =================================
LOG_LEVEL=debug
LOG_FORMAT=pretty

# =================================
# CORS
# =================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =================================
# Rate Limiting
# =================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# =================================
# Optional: Monitoring
# =================================
# SENTRY_DSN=
# PROMETHEUS_ENABLED=false
